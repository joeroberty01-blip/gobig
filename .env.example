# Copy to .env and fill in. Never commit .env.

# Neon Postgres. DATABASE_URL = pooled (host contains "-pooler"), DIRECT_URL = direct host,
# used by Prisma migrations.
DATABASE_URL=""
DIRECT_URL=""

# Integration tests only. Must point at a separate Neon branch, never the one in DATABASE_URL.
DATABASE_URL_TEST=""

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Public base URL, used to build password-reset links.
APP_URL="http://localhost:3000"

# Email for password reset. If blank, development prints the reset link to the server console;
# production logs an error and sends nothing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional SMS for password reset on phone-only accounts (SMSGate, https://sms-gate.app).
SMS_GATEWAY_URL="https://api.sms-gate.app/3rdparty/v1"
SMS_GATEWAY_USER=""
SMS_GATEWAY_PASS=""

# Read once by `npm run db:seed:super-admin`. Clear the password from .env afterwards.
SUPER_ADMIN_NAME=""
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Object storage (S3-compatible; Neon Object Storage). The media bucket must be public_read.
# S3_ENDPOINT_TEST = the test branch's storage endpoint, used by integration tests only.
S3_ENDPOINT=""
S3_ENDPOINT_TEST=""
S3_REGION="eu-central-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_MEDIA_BUCKET="provider-media"

# Map tiles (public — shipped to the browser). OSM's own tile servers are for development only;
# use a tile provider with a key for production.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Private bucket (NOT public_read) for verification documents; served only via short-lived signed URLs.
S3_PRIVATE_BUCKET="verification-docs"

# Salt for anonymous daily visitor hashes in click analytics. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ANALYTICS_SALT=""

# AI search (Phase 9). Optional: without it, /ask uses the built-in rule-based parser.
# Server-side only — never expose it to the browser (no NEXT_PUBLIC_ prefix).
ANTHROPIC_API_KEY=""
# Phase 13 (SEC-036): at most this many model calls per day across the whole platform (default 2000;
# 0 = never call the model). Also set a monthly spend limit in the Anthropic Console.
AI_DAILY_CALL_CAP=""

# Two-factor login (Phase 13): 32 random bytes, base64. Encrypts admins' authenticator secrets.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable — changing it forces every admin to set up two-factor again.
TOTP_ENCRYPTION_KEY=""

# Phase 16: encryption key for sensitive fields (exact trip locations, recipient phone numbers).
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: move the old key to DATA_ENCRYPTION_KEY_PREVIOUS and put a new one here.
DATA_ENCRYPTION_KEY=""
DATA_ENCRYPTION_KEY_PREVIOUS=""

# Phase 16 (optional): Redis for rate limits and live updates. Blank = Postgres fallback.
REDIS_URL=""
# Phase 16 (optional): a read replica for public browsing. Blank = the primary database.
DATABASE_URL_READ=""
# Phase 16: connections per server instance (keep instances x this under the database limit).
DB_POOL_MAX="10"
# Phase 16: shared secret for the job tick endpoint (/api/cron/tick). Blank = endpoint disabled.
CRON_SECRET=""

# Phase 19 (SEC-052): how many proxies in front of the app append to X-Forwarded-For. The visitor's
# address is that many entries from the right. Render: 3. Local/no proxy: 1. Alternatively name a
# header your host overwrites (never one a client can set) in CLIENT_IP_HEADER.
TRUSTED_PROXY_HOPS="1"
CLIENT_IP_HEADER=""
# Phase 19: seconds identical public pages/searches share data (0 = off).
PUBLIC_CACHE_SEC="20"

# Phase C: Web Push. Generate with `npx web-push generate-vapid-keys`. The PUBLIC key is shared
# with browsers; the PRIVATE key is a secret. Blank = push off (in-app notifications still work).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@nexa.co.tz"
